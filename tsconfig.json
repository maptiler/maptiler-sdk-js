{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      // Types for the demos' import of the shipped Vite helper — Node resolution ignores package
      // `exports`, and at runtime vite.config-dev.ts aliases it to bundler-helpers/vite-worker.mjs
      "@maptiler/sdk/vite-worker": ["../bundler-helpers/side-effect.d.ts"]
    },
    "moduleResolution": "Node",
    "target": "es2021",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "es2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
  },
  "exclude": [
    "vite.config-*.ts",
    "vitest-setup-tests.ts",
    "dist"
  ],
  "include": [
    "vite.config-dev.ts",
    "vite.config-es.ts",
    "vite.config-umd.ts",
    "vite.config-test.ts",
    "vitest-setup-tests.ts",
    "src",
    "demos",
    "test"
  ],
}